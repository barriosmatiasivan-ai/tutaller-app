# Puerto del servidor (en Railway o Render se asigna automáticamente)
PORT=3000

# Ruta persistente de la sesión (en Railway montar un Volume en /data)
SESSION_DIR=/data/session_auth

# Clave para envío de mensajes
BOT_API_KEY=
# Clave de administración, compartida solo con el servidor de Pages
BOT_ADMIN_KEY=
